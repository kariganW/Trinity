import React, { useEffect, useState } from 'react'
import { supabase } from '../lib/supabase'

export default function PlayPage() {
  const [chat, setChat] = useState('')
  const [messages, setMessages] = useState<{id:number, user:string, text:string}[]>([])

  useEffect(() => {
    // placeholder: load last messages (this will later query chat_messages)
    setMessages([{id:1, user:'System', text:'Welcome to Trinity!'}])
  }, [])

  async function sendMessage(e: React.FormEvent) {
    e.preventDefault()
    if (!chat) return
    // placeholder: push to DB / realtime
    setMessages(m => [...m, { id: Date.now(), user: 'You', text: chat }])
    setChat('')
  }

  return (
    <div className="grid grid-cols-3 gap-4">
      <section className="col-span-2 bg-white p-4 rounded h-[60vh]">
        <h2 className="font-semibold mb-2">Map</h2>
        <div className="w-full h-full bg-gray-200 rounded flex items-center justify-center text-gray-600">
          Map grid placeholder — movement and fog of war go here.
        </div>
      </section>

      <aside className="bg-white p-4 rounded h-[60vh] flex flex-col">
        <h3 className="font-semibold mb-2">Global Chat</h3>
        <div className="flex-1 overflow-auto space-y-2 mb-4">
          {messages.map(m => (
            <div key={m.id}><strong>{m.user}:</strong> {m.text}</div>
          ))}
        </div>
        <form onSubmit={sendMessage} className="flex gap-2">
          <input value={chat} onChange={e => setChat(e.target.value)} className="flex-1 p-2 border rounded" placeholder="Say something..." />
          <button className="bg-indigo-600 text-white p-2 rounded">Send</button>
        </form>
      </aside>
    </div>
  )
}
